# Copia este archivo como `.env` si quieres cambiar los valores por defecto.
# Vite solo expone al frontend las variables con prefijo VITE_.

# Ruta base de la API. Por defecto usa /api, que el proxy de Vite reenvía a
# http://localhost:4000 (ver vite.config.js). Déjalo así para que la vista
# previa desde el celular funcione sin configurar IPs.
VITE_API_URL=/api

# Puerto del backend Express (solo lo lee server/index.js).
PORT=4000

# Solo para publicar un build estático (hosting sin reescritura de rutas):
# VITE_ROUTER=hash  -> usa rutas con # (/#/tickets) en lugar de rutas normales
# VITE_PREVIEW=1    -> avisa que las descargas están bloqueadas por el visor
# Ejemplo: VITE_ROUTER=hash VITE_PREVIEW=1 npx vite build --base ./
